:var(--red);color:#fff;padding:2px 6px;font-size:10px}.sidebar-footer{position:absolute;bottom:18px;left:12px;right:12px;display:grid;gap:5px;border-top:1px solid var(--border);padding-top:14px}\r\n.main{min-width:0;flex:1}.topbar{height:80px;padding:0 32px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:20px;background:color-mix(in srgb,var(--bg) 90%,transparent);position:sticky;top:0;z-index:1}.crumb span{font-size:10px;color:var(--muted);letter-spacing:.11em;font-weight:700}.crumb h1{font-size:18px;margin:6px 0 0}.top-actions{display:flex;align-items:center;gap:9px}.search-wrap{display:flex;align-items:center;gap:7px;border:1px solid var(--border);background:var(--surface);border-radius:8px;padding:8px 10px;color:var(--muted)}.search-wrap input{width:145px;border:0;outline:0;background:transparent;color:var(--text)}kbd{font-size:10px;color:var(--muted);border:1px solid var(--border);border-radius:4px;padding:2px 4px}.live-dot{font-size:11px;color:var(--green);font-weight:700;white-space:nowrap}.icon-button,.ghost,.secondary,.destructive{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid var(--border);background:var(--surface);color:var(--muted);border-radius:8px;padding:9px 12px}.icon-button:hover,.secondary:hover,.ghost:hover{color:var(--text);border-color:var(--indigo)}.icon-button.selected{color:var(--indigo);border-color:var(--indigo)}.primary{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:0;border-radius:8px;padding:10px 14px;background:var(--indigo);color:#fff;font-weight:600}.primary:disabled{opacity:.45;cursor:not-allowed}.destructive{background:color-mix(in srgb,var(--red) 12%,var(--surface));border-color:color-mix(in srgb,var(--red) 35%,var(--border));color:var(--red)}\r\n.global-bar{display:flex;justify-content:space-between;align-items:center;padding:11px 32px;border-bottom:1px solid var(--border);color:var(--muted)}.global-bar>div