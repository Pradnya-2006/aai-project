r:0;border-top:1px solid var(--border);background:transparent;color:var(--text);text-align:left;padding:12px 0}.rank-row:first-child,.mention-row:first-child{border-top:0}.rank-row b{color:var(--muted);font-size:11px}.rank-row span{display:grid;gap:3px;flex:1}.rank-row small,.mention-row small{color:var(--muted);font-size:11px}.rank-row em{font-style:normal;font-variant-numeric:tabular-nums;color:var(--muted)}.mention-list{margin-top:13px}.mention-row{align-items:flex-start}.sentiment-dot{width:8px;height:8px;border-radius:50%;margin-top:5px;flex:none}.sentiment-dot.positive,.positive{background:var(--green)}.sentiment-dot.negative,.negative{background:var(--red)}.sentiment-dot.neutral,.neutral{background:var(--muted)}.mention-copy{display:grid;gap:3px;flex:1}.mention-copy p{margin:0;color:var(--muted);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.impact{font-weight:700;color:var(--indigo);font-variant-numeric:tabular-nums}.impact small{display:block;font-size:9px;color:var(--muted);font-weight:400}.muted{color:var(--muted);font-size:12px}.text-button{display:inline-flex;align-items:center;gap:5px;border:0;background:transparent;color:var(--indigo);padding:0}.filter-panel{display:flex;gap:8px;align-items:center;margin-bottom:15px}.topic-layout,.risk-grid,.response-layout{display:grid;grid-template-columns:1.5fr 1fr;gap:12px}.bubble-network{height:480px;position:relative;overflow:hidden;background-image:radial-gradient(var(--border) 1px,transparent 1px);background-size:24px 24px}.topic-bubble{position:absolute;transform:translate(-50%,-50%);border-radius:50%;border:2px solid var(--green);background:color-mix(in srgb,var(--green) 19%,var(--surface));color:var(--text);font-size:11px;padding:7px;display:grid;place-items:center;text-align:center}.topic-bubble.risk{border-color:var(--red);background:color-mix(in srgb,var(--red) 18%,var(--surface))}.topic-bubble small{display:block;color:var(--muted);font-size:10px}.inspector{min-height:300px}.m