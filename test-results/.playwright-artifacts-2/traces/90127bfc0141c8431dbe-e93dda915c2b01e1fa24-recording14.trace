U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;\n}"],["STYLE",{},":root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;font-synthesis:none;text-rendering:optimizeLegibility;color-scheme:dark}\r\n*{box-sizing:border-box}html,body,#root{width:100%;max-width:100%;overflow-x:clip}body{margin:0;min-width:320px;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{cursor:pointer}\r\n.theme-dark{--bg:#080b14;--surface:#101522;--surface-2:#151c2b;--border:#253047;--text:#edf1fb;--muted:#8994aa;--indigo:#6875f5;--green:#39d98a;--amber:#f6bd55;--red:#ff6673}\r\n.theme-light{--bg:#f4f6fa;--surface:#fff;--surface-2:#eef1f7;--border:#dfe4ee;--text:#10182a;--muted:#627087;--indigo:#4f46e5;--green:#168a54;--amber:#ae6b00;--red:#c7354c;color-scheme:light}\r\n.app{display:flex;min-height:100vh;max-width:100vw;overflow:hidden;background:var(--bg);color:var(--text);font-size:14px}.sidebar{position:sticky;top:0;height:100vh;width:248px;flex:none;padding:20px 12px;border-right:1px solid var(--border);background:var(--surface);transition:width .25s;z-index:2}.sidebar.collapsed{width:72px}.brand{display:flex;align-items:center;gap:10px;padding:2px 10px 28px}.brand-mark{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;background:var(--indigo);color:#fff;font-weight:700}.brand strong,.brand span{display:block}.brand span,.eyebrow{font-size:10px;letter-spacing:.11em;color:var(--muted);font-weight:700}.sidebar-toggle{position:absolute;right:10px;top:22px}.sidebar nav{display:grid;gap:4px;margin-top:24px}.nav-item,.profile{display:flex;align-items:center;gap:12px;width:100%;min-height:42px;padding:10px;border:0;border-radius:9px;background:transparent;color:var(--muted);text-align:left}.nav-item:hover,.nav-item.active{color:var(--text);background:color-mix(in srgb,var(--indigo) 14%,transparent)}.nav-item.active{border-left:2px solid var(--indigo)}.nav-badge{margin-left:auto;border-radius:99px;background:var(--red);color:#fff;padding:2px 6px;font-size:10px}.sidebar-footer{position:absolute;bottom:18px;left:12px;right:12px;display:grid;gap:5px;border-top:1px solid var(--border);padding-top:14px}\r\n.main{min-width:0;flex:1}.topbar{height:80px;padding:0 32px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:20px;background:color-mix(in srgb,var(--bg) 90%,transparent);position:sticky;top:0;z-index:1}.crumb span{font-size:10px;color:var(--muted);letter-spacing:.11em;font-weight:700}.crumb h1{font-size:18px;margin:6px 0 0}.top-actions{display:flex;align-items:center;gap:9px}.search-wrap{display:flex;align-items:center;gap:7px;border:1px solid var(--border);background:var(--surface);border-radius:8px;padding:8px 10px;color:var(--muted)}.search-wrap input{width:145px;border:0;outline:0;background:transparent;color:var(--text)}kbd{font-size:10px;color:var(--muted);border:1px solid var(--border);border-radius:4px;padding:2px 4px}.live-dot{font-size:11px;color:var(--green);font-weight:700;white-space:nowrap}.icon-button,.ghost,.secondary,.destructive{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px solid var(--border);background:var(--surface);color:var(--muted);border-radius:8px;padding:9px 12px}.icon-button:hover,.secondary:hover,.ghost:hover{color:var(--text);border-color:var(--indigo)}.icon-button.selected{color:var(--indigo);border-color:var(--indigo)}.primary{display:inline-flex;align-items:center;justify-content:center;gap:7px;border:0;border-radius:8px;padding:10px 14px;background:var(--indigo);color:#fff;font-weight:600}.primary:disabled{opacity:.45;cursor:not-allowed}.destructive{background:color-mix(in srgb,var(--red) 12%,var(--surface));border-color:color-mix(in srgb,var(--red) 35%,var(--border));color:var(--red)}\r\n.global-bar{display:flex;justify-content:space-between;align-items:center;padding:11px 32px;border-bottom:1px solid var(--border);color:var(--muted)}.global-bar>div{display:flex;align-items:center;gap:7px}.filter{border:1px solid var(--border);border-radius:99px;padding:6px 10px;background:var(--surface);color:var(--muted);font-size:12px}.filter.selected{color:var(--text);border-color:var(--indigo);background:color-mix(in srgb,var(--indigo) 12%,var(--surface))}.content{max-width:1800px;margin:auto;padding:30px 32px}.page-title{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:24px}.page-title h2{font-size:28px;letter-spacing:-.04em;margin:8px 0 5px}.subhead{margin:0;color:var(--muted);line-height:1.55}.card{border:1px solid var(--border);border-radius:12px;background:var(--surface);padding:20px;box-shadow:0 4px 12px #00000012;transition:transform .2s,border-color .2s}.card:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--indigo) 45%,var(--border))}.metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:12px}.kpi-head,.card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.card-head>div:first-child{display:flex;align-items:center;gap:7px}.card-head h3{font-size:15px;margin:0}.help-button{display:grid;place-items:center;border:0;background:transparent;color:var(--muted);padding:0}.kpi-icon{display:grid;place-items:center;padding:7px;border-radius:8px}.kpi-icon.positive{color:var(--green);background:color-mix(in srgb,var(--green) 12%,transparent)}.kpi-icon.negative,.kpi-icon.critical{color:var(--red);background:color-mix(in srgb,var(--red) 12%,transparent)}.kpi-icon.neutral{color:var(--indigo);background:color-mix(in srgb,var(--indigo) 12%,transparent)}.kpi-value,.success-score{font-variant-numeric:tabular-nums;font-size:30px;font-weight:700;margin:18px 0 10px}.kpi-value small{font-size:14px;color:var(--muted);font-weight:400;margin-left:3px}.sparkline{height:28px;display:flex;align-items:end;gap:4px;margin-bottom:10px}.sparkline i{display:block;flex:1;border-radius:3px 3px 0 0;background:var(--indigo);opacity:.75}