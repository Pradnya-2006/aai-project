:-4px;right:-4px;background:var(--red);color:#fff;border-radius:99px;font-size:10px;font-weight:700;padding:1px 5px;min-width:16px;text-align:center;line-height:14px}\r\n.notification-popover{position:absolute;right:0;top:100%;margin-top:8px;width:340px;max-height:440px;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:0 12px 35px rgba(0,0,0,0.4);z-index:100;display:flex;flex-direction:column;overflow:hidden}\r\n.notification-popover-head{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;border-bottom:1px solid var(--border);font-size:13px}\r\n.notification-list{overflow-y:auto;max-height:380px;display:flex;flex-direction:column}\r\n.notification-item{display:flex;flex-direction:column;align-items:flex-start;gap:4px;padding:12px 14px;border:0;border-bottom:1px solid var(--border);background:transparent;color:var(--text);text-align:left;cursor:pointer;transition:background .15s}\r\n.notification-item:hover{background:var(--surface-2)}\r\n.notification-item.unread{background:color-mix(in srgb,var(--indigo) 8%,var(--surface))}\r\n.notification-item-head{display:flex;justify-content:space-between;align-items:center;width:100%}\r\n.kind-pill{font-size:9px;font-weight:700;padding:2px 6px;border-radius:4px;text-transform:uppercase;background:var(--surface-2);color:var(--muted)}\r\n.kind-pill.kind-critical{background:color-mix(in srgb,var(--red) 18%,transparent);color:var(--red)}\r\n.kind-pill.kind-trend{background:color-mix(in srgb,var(--green) 18%,transparent);color:var(--green)}\r\n.kind-pill.kind-response{background:color-mix(in srgb,var(--indigo) 18%,transparent);color:var(--indigo)}\r\n.kind-pill.kind-team_alert{background:color-mix(in srgb,var(--amber) 18%,transparent);color:var(--amber)}\r\n.unread-dot{width:6px;height:6px;border-radius:50%;background:var(--indigo)}\r\n.notification-item strong{font-size:12px}\r\n.notification-item p{margin:0;font-size:11px;color:var(--muted);line-height:1.4}\r\n.notification-route{color:var(--indigo);font-size:10px;margin-top:2px}\r\n.status-pill{font-size:10px;font-weight:700;padding:3px 7px;border-radius:6px;background:var(--surface-2);color:var(--muted);letter-spacing:.04em}\r\n.status-pill.status-approved{background:color-mix(in srgb,var(--green) 18%,transparent);color:var(--green)}\r\n.status-pill.status-rejected{background:color-mix(in srgb,var(--red) 18%,transparent);color:var(--red)}\r\n.status-pill.status-pending_review{background:color-mix(in srgb,var(--amber) 18%,transparent);color:var(--amber)}\r\n.status-pill.status-published{background:color-mix(in srgb,var(--indigo) 18%,transparent);color:var(--indigo)}\r\n.mention-pills{display:flex;flex-wrap:wrap;gap:5px;margin-top:7px}.mention-pills em{font-style:normal;font-size:10px;border:1px solid var(--border);border-radius:99px;padding:2px 6px;color:var(--muted)}.mention-pills .pill-negative{color:var(--red);border-color:color-mix(in srgb,var(--red) 45%,var(--border))}.mention-pills .pill-positive{color:var(--green);border-color:color-mix(in srgb,var(--green) 45%,var(--border))}.crisis-alert{margin:14px 0;color:var(--amber);border-left-color:var(--amber)}.crisis-live-chart{margin-top:18px;border-top:1px solid var(--border);padding-top:16px}.mini-chart{height:120px;display:flex;align-items:end;gap:8px;padding:10px 4px 0}.mini-chart i{flex:1;min-height:4px;background:linear-gradient(180deg,var(--red),color-mix(in srgb,var(--red) 30%,transparent));border-radius:4px 4px 0 0}.crisis-recommendation{margin-top:16px;border-color:color-mix(in srgb,var(--red) 45%,var(--border))}.topic-bubble{overflow:hidden;white-space:normal;line-height:1.15}\r\n.metric-line.clickable{width:100%;display:grid;grid-template-columns:1fr auto;gap:5px;border:0;border-bottom:1px solid var(--border);background:transparent;color:var(--text);padding:12px 0;text-align:left}.metric-line.clickable small{grid-column:1 / -1;color:var(--muted);line-height:1.4}.section-label{margin:18px 0 8px;font-size:12px;tex